# When running with Docker Compose, use "db" as host (the postgres service name)
DATABASE_URL=postgresql+asyncpg://radar:radar_dev@db:5432/ai_radar
# When running locally (outside Docker): DATABASE_URL=postgresql+asyncpg://radar:radar_dev@localhost:5432/ai_radar

# AI — Vertex AI (dùng Application Default Credentials)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
# Nếu dùng Service Account JSON: đặt path tới file key
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/sa-key.json

# Backend
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Admin API
ADMIN_API_KEY=changeme

# Cost controls (quota Gemini)
MIN_CONTENT_LENGTH=200
MAX_DAILY_ANALYSIS=500        # cap số tài liệu phân tích/ngày (persist trong DB)

# Document lifecycle (W1 quota guard)
MAX_AGE_MONTHS=6             # bài published cũ hơn ngưỡng này bị bỏ qua khi ingest
RETENTION_MONTHS=6          # insight/tài liệu quá hạn này bị tombstone-purge (giữ fingerprint)

# Scheduler nhúng (tự động ingest+analysis + purge)
# LƯU Ý: chỉ bật ở production. Dev để false.
ENABLE_SCHEDULER=false
SCHEDULER_HOURS=7,13,19      # giờ VN chạy ingest+analysis mỗi ngày
PURGE_HOUR=3                # giờ VN chạy tombstone-purge hằng ngày
INGEST_SOURCE_DELAY_SECONDS=1.0   # giãn request giữa các nguồn (tránh 429/403)
INGEST_JITTER_SECONDS=2.0
FETCH_MAX_RETRIES=3
FETCH_BACKOFF_BASE_SECONDS=2.0

# Delivery — bản tin định kỳ qua email (M7). Mặc định TẮT; bật sau khi
# `run_delivery --dry-run` cho kết quả đúng.
DELIVERY_ENABLED=false
DELIVERY_CHANNEL=email
DELIVERY_DIGEST_HOUR=8               # giờ VN gửi bản tin (Thứ Hai + Thứ Năm)
DELIVERY_DIGEST_DAYS=mon,thu         # ngày trong tuần gửi bản tin
DELIVERY_DIGEST_LOOKBACK_HOURS=108   # 4.5 ngày — rộng hơn khoảng cách 2 kỳ + đệm 12h
DELIVERY_MAX_ITEMS_PER_ROLE=2        # trần tin mỗi vai trò
DELIVERY_MAX_ITEMS_PER_EMAIL=3       # trần tin mỗi email (áp lên tổng)
DELIVERY_MIN_GAP_HOURS=48            # chốt chặn: không gửi lại cho cùng người trong ngần này giờ
DASHBOARD_BASE_URL=http://localhost:5173   # gốc link "đọc chi tiết" trong email
PUBLIC_API_BASE_URL=http://localhost:8000  # gốc link hủy nhận — backend, KHÁC dashboard

# SMTP — Gmail App Password (bật 2FA rồi tạo App Password 16 ký tự)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587                        # 587 = STARTTLS, 465 = SSL implicit
SMTP_USER=                           # địa chỉ Gmail chung dùng để gửi
SMTP_PASSWORD=                       # App Password, KHÔNG phải mật khẩu đăng nhập
EMAIL_FROM=                          # thường trùng SMTP_USER
EMAIL_FROM_NAME=AI Radar
EMAIL_REPLY_TO=                      # hộp thư người thật để nhận phản hồi (tuỳ chọn)

# Chat Q&A (M8) — budget TÁCH BIỆT khỏi analysis.
# ⚠️ Khác đơn vị: MAX_DAILY_ANALYSIS đếm TÀI LIỆU (1 tài liệu = 2 lượt gọi model),
# MAX_DAILY_CHAT_CALLS đếm LƯỢT GỌI. Đừng so trực tiếp hai số này.
MAX_DAILY_CHAT_CALLS=200
CHAT_WINDOW_DAYS=0                   # van xả phụ: lọc theo độ mới; 0 = cả corpus
CHAT_INDEX_TOP_K=60                  # van xả CHÍNH: trần số tin vào index sau khi xếp hạng
CHAT_DEEP_SLOTS=3                    # số tin rót SÂU (7 field + bài gốc); phần còn lại là index nén
CHAT_DEEP_INCLUDE_CONTENT=true       # ô sâu có kèm bài gốc không (false = chỉ 7 field phân tích)

# --- Tra cứu ngoài khi corpus thiếu dữ kiện (chat-web-fallback) ---
# ⚠️ MẶC ĐỊNH TẮT, và hãy để nguyên vậy cho tới khi bạn tự đo tỉ lệ sentinel giả. Đây là
# đường DUY NHẤT trong chat tiêu tiền theo một đơn giá khác hẳn: Grounding with Google Search
# tính ~$35/1.000 truy vấn (Gemini 2.x) trong khi cả một câu trả lời chỉ ~$0,006 — tức MỘT
# lần tra cứu ≈ 6× toàn bộ câu trả lời. Nó cũng mở nội dung web lạ vào prompt.
CHAT_WEB_FALLBACK_ENABLED=false
MAX_DAILY_WEB_SEARCHES=50            # đơn vị: TRUY VẤN tra cứu — bộ đếm RIÊNG, không dùng
                                     # chung với MAX_DAILY_CHAT_CALLS (đơn vị: lượt gọi model)
CHAT_WEB_MAX_SOURCES=3               # grounding trả về 9–10 nguồn ⇒ đây là cắt BẮT BUỘC
CHAT_WEB_SEARCH_MODEL_ID=gemini-2.5-flash-lite   # bước tra cứu chỉ tìm nguồn, không viết văn
CHAT_WEB_FETCH_TIMEOUT_SECONDS=8.0   # trần cho MỘT nguồn (giải chuyển hướng + tải); chạy song song

# Environment
ENV=development
